rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && request.auth.token.email == 'ajamjamaludin45@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isKades() {
      return isSignedIn() && (
        isBootstrappedAdmin() ||
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'kades')
      );
    }

    // Admins collection for RBAC lookup
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isBootstrappedAdmin();
    }

    // Users collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin() || isKades());
      allow list: if isAdmin() || isKades();
      allow create: if isSignedIn() && request.auth.uid == userId && (incoming().role == 'warga' || isBootstrappedAdmin());
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && incoming().role == existing().role) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Submissions collection
    match /submissions/{submissionId} {
      allow get: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        isKades()
      );
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        isKades()
      );
      allow create: if isSignedIn() &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'menunggu' &&
        incoming().type in ['kelahiran', 'kematian', 'pindah_masuk', 'pindah_keluar'];
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          resource.data.userId == request.auth.uid &&
          resource.data.status == 'menunggu' &&
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'details', 'attachments', 'updatedAt'])
        )
      );
      allow delete: if isAdmin() || (
        isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        resource.data.status == 'menunggu'
      );
    }

    // Residents master archive
    match /residents/{residentId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
  }
}
